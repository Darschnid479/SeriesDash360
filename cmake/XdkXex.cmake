set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
set(CMAKE_STATIC_LIBRARY_PREFIX "")
set(CMAKE_STATIC_LIBRARY_SUFFIX ".lib")
set(CMAKE_EXECUTABLE_SUFFIX ".exe")
set(CMAKE_LINK_LIBRARY_FLAG "")
set(CMAKE_LIBRARY_PATH_FLAG "/LIBPATH:")
set(CMAKE_LINK_LIBRARY_SUFFIX ".lib")
set(CMAKE_C_LINK_LIBRARY_SUFFIX ".lib")
set(CMAKE_CXX_LINK_LIBRARY_SUFFIX ".lib")
set(CMAKE_CXX_COMPILE_OBJECT "<CMAKE_CXX_COMPILER> /nologo <DEFINES> <INCLUDES> <FLAGS> /c <SOURCE> /Fo<OBJECT>")
set(CMAKE_C_COMPILE_OBJECT "<CMAKE_C_COMPILER> /nologo <DEFINES> <INCLUDES> <FLAGS> /c <SOURCE> /Fo<OBJECT>")
set(CMAKE_CXX_LINK_EXECUTABLE "<CMAKE_LINKER> /nologo /LTCG <LINK_FLAGS> <OBJECTS> /OUT:<TARGET> <LINK_LIBRARIES>")
set(_XDKXEX_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}" CACHE INTERNAL "")
function(add_xex target)
 cmake_parse_arguments(XEX "" "TYPE;CONFIG" "SOURCES;LIBRARIES" ${ARGN})
 if(NOT XEX_CONFIG) message(FATAL_ERROR "CONFIG required") endif()
 add_executable(${target} ${XEX_SOURCES})
 target_link_options(${target} PRIVATE "/SUBSYSTEM:XBOX" "/FIXED:NO" "/XEX:NO")
 target_link_libraries(${target} PRIVATE xboxkrnl xapilib ${XEX_LIBRARIES})
 set(_xex "${CMAKE_BINARY_DIR}/${target}.xex")
 add_custom_command(TARGET ${target} POST_BUILD
  COMMAND "${XDK_IMAGEXEX}" /IN:$<TARGET_FILE:${target}> /OUT:${_xex} /CONFIG:${XEX_CONFIG}
  COMMAND "${CMAKE_COMMAND}" -DXEX=${_xex} -DXEX_TYPE=EXE -DXDK_IMAGEXEX=${XDK_IMAGEXEX} -P "${_XDKXEX_MODULE_DIR}/verify-xex.cmake"
  BYPRODUCTS "${_xex}" VERBATIM)
endfunction()
